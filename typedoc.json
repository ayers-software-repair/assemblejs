{
  "$schema": "https://typedoc.org/schema.json",
  "name": "AssembleJS API reference",
  "tsconfig": "tsconfig.typedoc.json",
  "entryPointStrategy": "resolve",
  "entryPoints": [
    "packages/cli/src/index.ts",
    "packages/core/src/index.ts",
    "packages/core/src/client/index.ts",
    "packages/core/src/renderer/index.ts",
    "packages/create/src/index.ts",
    "packages/devtools/src/index.ts",
    "packages/mcp/src/index.ts",
    "packages/renderer-lit/src/index.ts",
    "packages/renderer-lit/src/client/index.ts",
    "packages/renderer-lit/src/client/hydration-support.ts",
    "packages/renderer-preact/src/index.ts",
    "packages/renderer-preact/src/client/index.ts",
    "packages/renderer-react/src/index.ts",
    "packages/renderer-react/src/client/index.ts",
    "packages/renderer-solid/src/index.ts",
    "packages/renderer-solid/src/client/index.ts",
    "packages/renderer-solid/src/compiler/index.ts",
    "packages/renderer-svelte/src/index.ts",
    "packages/renderer-svelte/src/client/index.ts",
    "packages/renderer-templates/src/index.ts",
    "packages/renderer-vue/src/index.ts",
    "packages/renderer-vue/src/client/index.ts"
  ],
  "out": "site/docs/api",
  "readme": "none",
  "excludeExternals": true,
  "excludeInternal": true,
  "githubPages": false,
  "cacheBust": true,
  "treatWarningsAsErrors": true
}
