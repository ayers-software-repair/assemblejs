{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@asmjs/core": ["./packages/core/src/index.ts"],
      "@asmjs/core/client": ["./packages/core/src/client/index.ts"],
      "@asmjs/core/outline": ["./packages/core/src/outline/index.ts"],
      "@asmjs/build": ["./packages/build/src/index.ts"],
      "@asmjs/check": ["./packages/check/src/index.ts"],
      "@asmjs/cli": ["./packages/cli/src/index.ts"],
      "@asmjs/create": ["./packages/create/src/index.ts"],
      "@asmjs/mcp": ["./packages/mcp/src/index.ts"],
      "@asmjs/renderer-lit": ["./packages/renderer-lit/src/index.ts"],
      "@asmjs/renderer-lit/client": ["./packages/renderer-lit/src/client/index.ts"],
      "@asmjs/renderer-preact": ["./packages/renderer-preact/src/index.ts"],
      "@asmjs/renderer-preact/client": ["./packages/renderer-preact/src/client/index.ts"],
      "@asmjs/renderer-react": ["./packages/renderer-react/src/index.ts"],
      "@asmjs/renderer-react/client": ["./packages/renderer-react/src/client/index.ts"],
      "@asmjs/renderer-solid": ["./packages/renderer-solid/src/index.ts"],
      "@asmjs/renderer-solid/client": ["./packages/renderer-solid/src/client/index.ts"],
      "@asmjs/renderer-solid/compiler": ["./packages/renderer-solid/src/compiler/index.ts"],
      "@asmjs/renderer-svelte": ["./packages/renderer-svelte/src/index.ts"],
      "@asmjs/renderer-svelte/client": ["./packages/renderer-svelte/src/client/index.ts"],
      "@asmjs/renderer-templates": ["./packages/renderer-templates/src/index.ts"],
      "@asmjs/devtools": ["./packages/devtools/src/index.ts"],
      "@asmjs/renderer-vue": ["./packages/renderer-vue/src/index.ts"],
      "@asmjs/renderer-vue/client": ["./packages/renderer-vue/src/client/index.ts"]
    }
  }
}
