{
  "name": "@assemblejs/cli",
  "version": "1.0.0",
  "description": "The AssembleJS command line: scaffold a project, add an assembly, build and run it.",
  "license": "Apache-2.0",
  "author": "Zachariah Ayers",
  "homepage": "https://ayers.repair/assemblejs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayers-software-repair/assemblejs.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/ayers-software-repair/assemblejs/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "assemblejs": "./dist/bin.js",
    "asm": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src test",
    "check:publish": "publint && attw --pack . --profile esm-only"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "26.4.1",
    "publint": "0.3.24",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
