{
  "name": "@assemblejs/renderer-lit",
  "version": "1.0.0",
  "description": "Write an AssembleJS assembly in Lit.",
  "license": "Apache-2.0",
  "author": "Zachariah Ayers",
  "homepage": "https://ayers.repair/assemblejs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayers-software-repair/assemblejs.git",
    "directory": "packages/renderer-lit"
  },
  "bugs": "https://github.com/ayers-software-repair/assemblejs/issues",
  "type": "module",
  "sideEffects": [
    "./dist/client/*.js",
    "./dist/chunk-*.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "browser": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./hydration-support": {
      "types": "./dist/client/hydration-support.d.ts",
      "browser": "./dist/client/hydration-support.js",
      "default": "./dist/client/hydration-support.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src test",
    "check:publish": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@lit-labs/ssr": "4.1.0",
    "@lit-labs/ssr-client": "1.1.8"
  },
  "peerDependencies": {
    "@assemblejs/core": "1.x",
    "lit": "^3.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@assemblejs/core": "workspace:*",
    "@types/node": "26.4.1",
    "lit": "3.3.3",
    "publint": "0.3.24",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "assemblejs": {
    "frameworkPackages": [
      "lit"
    ],
    "viewExtensions": [
      ".lit.ts",
      ".lit.js"
    ]
  }
}
