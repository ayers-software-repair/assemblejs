{
  "name": "@assemblejs/renderer-templates",
  "version": "1.0.0",
  "description": "Write an AssembleJS assembly as an EJS, Markdown, Nunjucks, Handlebars or Pug template.",
  "license": "Apache-2.0",
  "homepage": "https://ayers.repair/assemblejs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayers-software-repair/assemblejs.git",
    "directory": "packages/renderer-templates"
  },
  "bugs": "https://github.com/ayers-software-repair/assemblejs/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src test",
    "check:publish": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "ejs": "6.0.1",
    "handlebars": "4.7.9",
    "markdown-it": "15.0.2",
    "nunjucks": "3.2.4",
    "pug": "3.0.4"
  },
  "peerDependencies": {
    "@assemblejs/core": "1.x"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@assemblejs/core": "workspace:*",
    "@types/ejs": "3.1.5",
    "@types/node": "26.4.1",
    "@types/nunjucks": "3.2.6",
    "@types/pug": "2.0.10",
    "publint": "0.3.24",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "assemblejs": {
    "frameworkPackages": [],
    "viewExtensions": [
      ".ejs",
      ".md",
      ".njk",
      ".hbs",
      ".pug"
    ]
  }
}
