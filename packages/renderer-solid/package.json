{
  "name": "@assemblejs/renderer-solid",
  "version": "1.0.0-next.0",
  "description": "Write an AssembleJS assembly in Solid.",
  "license": "Apache-2.0",
  "homepage": "https://ayers.repair/assemblejs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayers-software-repair/assemblejs.git",
    "directory": "packages/renderer-solid"
  },
  "bugs": "https://github.com/ayers-software-repair/assemblejs/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "browser": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./compiler": {
      "types": "./dist/compiler/index.d.ts",
      "default": "./dist/compiler/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint src test",
    "check:publish": "publint && attw --pack . --profile esm-only"
  },
  "dependencies": {
    "@babel/core": "7.29.7",
    "babel-preset-solid": "1.9.15"
  },
  "peerDependencies": {
    "@assemblejs/core": "1.0.0-next.0",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@assemblejs/core": "workspace:*",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.4.1",
    "esbuild": "0.28.2",
    "publint": "0.3.24",
    "solid-js": "1.9.15",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "assemblejs": {
    "frameworkPackages": [
      "solid-js"
    ],
    "viewExtensions": [
      ".solid.tsx",
      ".solid.jsx"
    ]
  }
}
