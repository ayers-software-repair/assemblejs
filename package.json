{
  "name": "assemblejs-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "author": "Zachariah Ayers",
  "license": "Apache-2.0",
  "homepage": "https://ayers.repair/assemblejs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayers-software-repair/assemblejs.git"
  },
  "ayersPlatform": "v0.20.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "changeset": "changeset",
    "check": "pnpm check:identity && pnpm check:headers && pnpm check:emoji && pnpm check:organization && pnpm check:mirror && pnpm check:versions && pnpm lint && pnpm check:modules && pnpm typecheck && pnpm test && pnpm build && pnpm check:exports && pnpm check:pack && pnpm check:unused && pnpm check:publish",
    "check:emoji": "node scripts/check-emoji.mjs --self-test && node scripts/check-emoji.mjs",
    "check:exports": "node scripts/check-exports.mjs",
    "check:headers": "node scripts/check-headers.mjs",
    "check:identity": "bash scripts/identity-gate.sh --self-test && bash scripts/identity-gate.sh",
    "check:mirror": "node scripts/check-mirror.mjs --self-test && node scripts/check-mirror.mjs",
    "check:modules": "depcruise --config .dependency-cruiser.cjs packages",
    "check:organization": "node scripts/check-organization.mjs --self-test && node scripts/check-organization.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:publish": "pnpm -r --filter './packages/*' check:publish",
    "check:trailers": "bash scripts/check-trailers.sh --self-test && bash scripts/check-trailers.sh",
    "check:unused": "knip",
    "check:versions": "syncpack lint",
    "lint": "eslint .",
    "prepare": "husky",
    "test": "pnpm -r test",
    "test:browser": "playwright test -c browser/playwright.config.ts",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@changesets/cli": "3.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.1",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-unicorn": "74.0.0",
    "globals": "17.12.0",
    "happy-dom": "20.13.0",
    "husky": "9.1.7",
    "knip": "6.34.0",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "sort-package-json": "4.0.0",
    "syncpack": "15.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
