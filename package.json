{
  "name": "assemblejs-monorepo",
  "private": true,
  "type": "module",
  "author": "Zachariah Ayers",
  "license": "Apache-2.0",
  "homepage": "https://ayers.repair/assemblejs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ayers-software-repair/assemblejs.git"
  },
  "ayersPlatform": "v0.20.4",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm check:identity && pnpm check:headers && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:pack",
    "check:identity": "bash scripts/identity-gate.sh",
    "check:headers": "node scripts/check-headers.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "check:trailers": "bash scripts/check-trailers.sh",
    "changeset": "changeset",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "eslint": "10.9.1",
    "globals": "^17.12.0",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
