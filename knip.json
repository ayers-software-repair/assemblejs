{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "scripts/site/*.mjs",
        "browser/*.browser.ts",
        "browser/academy-runtime-research/runtime.probe.ts",
        "browser/academy-open-runtime-research/open-runtime.probe.ts",
        "browser/academy-open-runtime-research/framework-build.probe.ts",
        "browser/academy-open-runtime-research/pack-npm.mjs",
        "browser/academy-open-runtime-research/pack-npm.test.mjs",
        "browser/academy-open-runtime-research/framework-diagnostics.test.mjs",
        "browser/landing-proof/landing.probe.ts",
        "browser/build-fixture.mjs",
        "browser/fixtures/*.{ts,tsx}",
        "browser/build-examples.mjs",
        "browser/academy-editor/editor.probe.ts",
        "examples/academy/workspace/*.test.mjs",
        "browser/academy-editor/read-save-body.test.mjs",
        "browser/academy-editor/create-file-provider.test.mjs"
      ],
      "project": [
        "scripts/**/*.mjs",
        "browser/**/*.{ts,tsx,mjs}",
        "examples/academy/workspace/*.{js,mjs}",
        "browser/academy-editor/*.js"
      ],
      "ignoreDependencies": [
        "@arethetypeswrong/cli",
        "publint",
        "sort-package-json",
        "react-dom",
        "svelte-check",
        "vue-tsc"
      ]
    },
    "packages/*": {
      "entry": ["test/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    },
    "examples/two-frameworks": {
      "entry": ["src/server.ts", "src/assemblies/*/*.{ts,tsx,svelte}", "src/api/*.api.ts"],
      "project": ["src/**/*.{ts,tsx,svelte}"],
      "ignoreDependencies": ["@asmjs/renderer-svelte", "svelte"]
    },
    "examples/styles": {
      "entry": ["src/server.ts", "src/assemblies/*/*.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@asmjs/renderer-react", "@types/react-dom"]
    },
    "examples/frameworks": {
      "entry": ["src/server.ts", "src/assemblies/*/*.{ts,tsx,svelte}", "src/pages/*/*.page.ts"],
      "project": ["src/**/*.{ts,tsx,svelte}"],
      "ignoreDependencies": ["@asmjs/renderer-.*", "svelte", "vue"]
    },
    "examples/shadow": {
      "entry": ["src/server.ts", "src/assemblies/*/*.{ts,tsx,svelte}", "src/pages/*/*.page.ts"],
      "project": ["src/**/*.{ts,tsx,svelte}"],
      "ignoreDependencies": ["@asmjs/renderer-.*", "@types/react-dom", "svelte", "vue"]
    },
    "examples/templates": {
      "entry": ["src/server.ts", "src/assemblies/*/*.ts"],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@asmjs/renderer-templates"]
    },
    "examples/realtime": {
      "entry": [
        "src/server.ts",
        "assemblejs.config.ts",
        "src/assemblies/*/*.{ts,tsx,svelte}",
        "src/api/*.api.ts",
        "src/pages/*/*.page.ts"
      ],
      "project": ["src/**/*.{ts,tsx,svelte}"],
      "ignoreDependencies": ["@asmjs/renderer-svelte"]
    },
    "examples/market/shop": {
      "entry": [
        "src/server.ts",
        "assemblejs.config.ts",
        "src/assemblies/*/*.{ts,tsx,svelte}",
        "src/api/*.api.ts",
        "src/pages/*/*.page.ts"
      ],
      "project": ["src/**/*.{ts,tsx,svelte}"],
      "ignoreDependencies": [
        "@asmjs/renderer-.*",
        "lit",
        "preact",
        "react",
        "react-dom",
        "solid-js",
        "svelte",
        "vue"
      ]
    },
    "examples/market/catalog": {
      "entry": [
        "src/server.ts",
        "assemblejs.config.ts",
        "src/assemblies/*/*.{ts,tsx}",
        "src/api/*.api.ts",
        "src/pages/*/*.page.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@asmjs/renderer-.*", "lit", "preact", "react", "react-dom", "vue"]
    },
    "examples/market/reviews": {
      "entry": [
        "src/server.ts",
        "assemblejs.config.ts",
        "src/assemblies/*/*.ts",
        "src/api/*.api.ts",
        "src/pages/*/*.page.ts"
      ],
      "project": ["src/**/*.ts"],
      "ignoreDependencies": ["@asmjs/renderer-.*", "lit", "vue"]
    },
    "examples/market/fulfilment": {
      "entry": [
        "src/server.ts",
        "assemblejs.config.ts",
        "src/assemblies/*/*.{ts,tsx}",
        "src/api/*.api.ts",
        "src/pages/*/*.page.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["@asmjs/renderer-.*", "solid-js"]
    }
  }
}
